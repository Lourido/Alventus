<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el template de la navbar para mostrar el logo de la compañía -->
    <template id="navbar_logo_inherit" inherit_id="web.navbar" name="Navbar Logo Company">
        <xpath expr="//nav[@class='o_main_navbar']//a[@class='o_brand']" position="replace">
            <a class="o_brand" href="/web">
                <img t-if="request.env.company.logo" 
                     t-att-src="image_data_uri(request.env.company.logo)" 
                     alt="Logo" 
                     class="o_company_logo"/>
                <span t-if="not request.env.company.logo" class="o_brand_text">
                    <t t-esc="request.env.company.name"/>
                </span>
            </a>
        </xpath>
    </template>
</odoo>