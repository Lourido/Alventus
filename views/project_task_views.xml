<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit_dates" model="ir.ui.view">
        <field name="name">project.task.form.inherit.dates</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- 1. Ocultar el campo original sin borrarlo (para no romper el validador) -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- 2. Insertar los nuevos campos justo después del título de la tarea -->
            <xpath expr="//field[@name='name']" position="after">
                <group>
                    <group>
                        <field name="fecha_desde" widget="datetime"/>
                        <field name="fecha_hasta" widget="datetime"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>