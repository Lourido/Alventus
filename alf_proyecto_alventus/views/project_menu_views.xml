<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para abrir el Kanban de proyectos -->
    <record id="action_project_kanban" model="ir.actions.act_window">
        <field name="name">Viajes</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer viaje
            </p>
        </field>
    </record>

    <!-- Menú principal de Viajes -->
    <menuitem id="menu_project_main"
              name="Viajes"
              web_icon="alf_proyecto_alventus,static/description/icon.png"
              sequence="20"/>

    <!-- Submenú: Proyectos (Kanban) -->
    <menuitem id="menu_project_projects"
              name="Proyectos"
              parent="menu_project_main"
              action="action_project_kanban"
              sequence="1"/>

    <!-- Submenú: Nuevo viaje con tareas -->
    <menuitem id="menu_project_create_with_tasks"
              name="Nuevo viaje con tareas"
              parent="menu_project_main"
              action="action_project_create_with_tasks_wizard"
              sequence="5"/>

    <!-- Submenú: Importar ICS -->
    <menuitem id="menu_project_import_ics"
              name="Importar ICS"
              parent="menu_project_main"
              action="action_project_import_ics_wizard"
              sequence="10"/>
</odoo>