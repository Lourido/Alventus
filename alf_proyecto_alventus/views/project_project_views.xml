<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista de lista independiente para los Archivos de Ruta -->
    <record id="view_project_route_file_list" model="ir.ui.view">
        <field name="name">project.route.file.list</field>
        <field name="model">project.route.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="file_data" filename="file_name" string="Archivo"/>
                <field name="file_name" string="Nombre"/>
                <field name="description" string="Descripción / Notas"/>
            </list>
        </field>
    </record>

    <!-- 2. Herencia del formulario del proyecto -->
    <record id="view_project_form_inherit_alf_v2" model="ir.ui.view">
        <field name="name">project.project.form.inherit.alf.v2</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            
            <!-- Botones en la cabecera del proyecto -->
            <xpath expr="//header" position="inside">
                <button name="%(action_project_duplicate_wizard)d" 
                        type="action" 
                        string="Duplicar viaje" 
                        class="btn-secondary" 
                        invisible="not id"/>
                <button name="action_download_all_photos" 
                        type="object" 
                        string="Descargar todas las fotos (ZIP)" 
                        class="btn-secondary" 
                        icon="fa-download"
                        invisible="not id"/>
            </xpath>

            <!-- Campos superiores -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_id" string="Usuario responsable" widget="many2one_avatar_user"/>
                <field name="start_date" string="Fecha de inicio" invisible="1"/>
                <field name="end_date" string="Fecha de fin" invisible="1"/>
            </xpath>

            <!-- Ocultar pestañas -->
            <xpath expr="//page[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//page[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='analytic']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Pestaña Contactos de Referencia -->
            <xpath expr="//notebook" position="inside">
                <page string="Contactos de Referencia" name="reference_contacts">
                    <field name="reference_contact_ids" widget="many2many_tags"/>
                </page>
            </xpath>

            <!-- Pestaña Archivos de Ruta -->
            <xpath expr="//notebook" position="inside">
                <page string="Archivos de Ruta" name="route_files">
                    <field name="route_file_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="file_data" filename="file_name" string="Archivo"/>
                            <field name="file_name" string="Nombre"/>
                            <field name="description" string="Descripción / Notas"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        <strong>Instrucciones:</strong> Pulsa "Añadir" para abrir el formulario, sube el archivo y escribe la descripción. 
                        El nombre del archivo se guardará automáticamente.
                    </div>
                </page>
            </xpath>

            <!-- Pestaña Fotos del grupo/viaje -->
            <xpath expr="//notebook" position="inside">
                <page string="Fotos del grupo/viaje" name="group_photos">
                    <div class="mb-2 d-flex gap-2">
                        <button name="%(action_project_photo_upload_wizard)d" 
                                type="action" 
                                string="Subir fotos" 
                                class="btn-primary" 
                                icon="fa-upload"
                                context="{'default_project_id': id}"/>
                        <button name="action_open_photos_to_download" 
                                type="object" 
                                string="Descargar fotos" 
                                class="btn-secondary" 
                                icon="fa-download"/>
                    </div>
                    <field name="photo_ids" readonly="1">
                        <kanban create="false" delete="false" class="o_kanban_mobile">
                            <field name="image"/>
                            <field name="name"/>
                            <field name="description"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                        <div class="o_kanban_image_fill_left d-none d-md-block" 
                                             t-attf-style="background-image: url('#{kanban_image('project.photo', 'image', record.id.raw_value)}'); background-size: cover; background-position: center; min-height: 150px;">
                                        </div>
                                        <div class="oe_kanban_details">
                                            <div class="o_kanban_record_top">
                                                <div class="o_kanban_record_headings">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                                <div class="o_kanban_record_top_right">
                                                    <a name="action_download_photo" type="object" 
                                                       class="btn btn-sm btn-primary" title="Descargar foto individual">
                                                        <i class="fa fa-download"/> Descargar
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="o_kanban_record_body" t-if="record.description.raw_value">
                                                <field name="description"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        <strong>Galería de fotos:</strong> 
                        <ul class="mb-0">
                            <li>Pulsa <strong>"Subir fotos"</strong> para añadir nuevas fotos desde tu ordenador.</li>
                            <li>Pulsa <strong>"Descargar fotos"</strong> para seleccionar varias fotos y descargarlas en un archivo ZIP.</li>
                            <li>También puedes descargar fotos individuales pulsando el botón "Descargar" en cada una.</li>
                        </ul>
                        <br/>Estas fotos <u>NO se copiarán</u> al duplicar el viaje.
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>