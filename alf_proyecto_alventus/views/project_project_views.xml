<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista de lista independiente para los Archivos de Ruta -->
    <record id="view_project_route_file_list" model="ir.ui.view">
        <field name="name">project.route.file.list</field>
        <field name="model">project.route.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="file_data" filename="file_name" string="Archivo"/>
                <field name="file_name" string="Nombre"/>
                <field name="description" string="Descripción / Notas"/>
            </list>
        </field>
    </record>

    <!-- 2. Herencia del formulario del proyecto -->
    <record id="view_project_form_inherit_alf_v2" model="ir.ui.view">
        <field name="name">project.project.form.inherit.alf.v2</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            
            <!-- Botones en la cabecera del proyecto -->
            <xpath expr="//header" position="inside">
                <button name="%(action_project_duplicate_wizard)d" 
                        type="action" 
                        string="Duplicar viaje" 
                        class="btn-secondary" 
                        invisible="not id"/>
                <button name="action_download_all_photos" 
                        type="object" 
                        string="Descargar todas las fotos (ZIP)" 
                        class="btn-secondary" 
                        icon="fa-download"
                        invisible="not id"/>
            </xpath>

            <!-- Campos superiores -->
			            <!-- Responsables adicionales y toggle de visibilidad -->
            <xpath expr="//group//field[@name='user_id']" position="after">
                <field name="responsible_user_ids" string="Responsables adicionales" widget="many2many_avatar_user"/>
                <field name="invisible" invisible="1"/>
                <label for="invisible" string="Visibilidad"/>
                <div name="invisible_toggle">
                    <button name="action_toggle_invisible" type="object" string="VISIBLE" class="badge rounded-pill text-bg-success border-0" invisible="invisible"/>
                    <button name="action_toggle_invisible" type="object" string="INVISIBLE" class="badge rounded-pill text-bg-danger border-0" invisible="not invisible"/>
                </div>
            </xpath>
			
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_id" string="Usuario responsable" widget="many2one_avatar_user"/>
                <field name="start_date" string="Fecha de inicio" invisible="1"/>
                <field name="end_date" string="Fecha de fin" invisible="1"/>
            </xpath>

            <!-- Ocultar pestañas -->
            <xpath expr="//page[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//page[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='analytic']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Pestaña Contactos de Referencia -->
            <xpath expr="//notebook" position="inside">
                <page string="Contactos de Referencia" name="reference_contacts">
                    <field name="reference_contact_ids" widget="many2many_tags"/>
                </page>
            </xpath>

            <!-- Pestaña Archivos de Ruta -->
            <xpath expr="//notebook" position="inside">
                <page string="Archivos de Ruta" name="route_files">
                    <field name="route_file_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="file_data" filename="file_name" string="Archivo"/>
                            <field name="file_name" string="Nombre"/>
                            <field name="description" string="Descripción / Notas"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        <strong>Instrucciones:</strong> Pulsa "Añadir" para abrir el formulario, sube el archivo y escribe la descripción. 
                        El nombre del archivo se guardará automáticamente.
                    </div>
                </page>
            </xpath>

            <!-- Pestaña Fotos del grupo/viaje -->
            <xpath expr="//notebook" position="inside">
            <!-- Pestaña Fotos del grupo/viaje -->
				<page string="Fotos del grupo/viaje" name="group_photos">
					<button name="action_open_photos_to_download" type="object" 
							string="Descargar todas las fotos" 
							class="btn-primary mb-3" 
							icon="fa-download"/>
					
					<field name="photo_ids" widget="many2many" options="{'not_delete': True}">
						<kanban class="o_kanban_mobile" create="false" edit="false" delete="false">
							<field name="image"/>
							<field name="name"/>
							<field name="description"/>
							<templates>
								<t t-name="card">
									<div class="oe_kanban_global_click">
										<div class="o_kanban_image me-3">
											<img t-att-src="record.image.raw_value ? 'data:image/png;base64,' + record.image.raw_value : '/web/static/img/placeholder.png'" 
												 alt="Foto" 
												 class="o_image_64_cover"/>
										</div>
										<div class="oe_kanban_details">
											<strong class="o_kanban_record_title">
												<field name="name"/>
											</strong>
											<div class="o_kanban_record_body">
												<field name="description"/>
											</div>
											<div class="o_kanban_record_bottom">
												<div class="oe_kanban_bottom_left">
													<button name="action_download_photo" type="object" 
															class="btn btn-sm btn-primary" icon="fa-download">
														Descargar
													</button>
												</div>
											</div>
										</div>
									</div>
								</t>
							</templates>
						</kanban>
					</field>
				</page>
            </xpath>
            <!-- Pestaña Etapas del viaje (con acceso a los archivos de cada etapa) -->
            <xpath expr="//notebook" position="inside">
                <page string="Etapas del viaje" name="trip_stages">
                    <field name="stage_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="sequence" string="Orden" widget="handle"/>
                            <field name="name" string="Etapa"/>
                            <field name="attachment_count" string="📎 Archivos"/>
                            <field name="fold" string="Plegada"/>
                            <button name="action_open_stage_form" type="object"
                                    string="Ver etapa / Archivos"
                                    class="btn-primary btn-sm"
                                    icon="fa-folder-open"/>
							<button name="action_add_attachment" type="object"
                                    string="Subir archivo"
                                    class="btn-secondary btn-sm"
                                    icon="fa-upload"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        <i class="fa fa-info-circle me-1" role="img" aria-label="Info" title="Información"/>
                        <strong>Instrucciones:</strong> Pulsa <em>"Ver etapa / Archivos"</em> en cualquier fila 
                        para abrir el formulario de la etapa y acceder a sus archivos adjuntos.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
	
    <!-- 3. Herencia de la vista Kanban de proyectos (TARJETA PERSONALIZADA) -->
    <record id="view_project_kanban_inherit_alf" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.alf</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Declarar todos los campos que usaremos en la tarjeta -->
            <xpath expr="//kanban" position="inside">
                <field name="user_id"/>
                <field name="invisible"/>
                <field name="trip_days"/>
                <field name="task_count"/>
                <field name="is_favorite"/>
                <field name="date_start"/>
                <field name="date"/>
            </xpath>
            
            <!-- REEMPLAZO COMPLETO de la plantilla de tarjeta.
                 Al controlar nosotros todo el contenido, la línea 4 original
                 (nº tareas + reloj + avatar) desaparece para siempre. -->
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <!-- Línea 1: Nombre del viaje + estrella de favorito -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <field name="name" class="fw-bold fs-5" placeholder="Viaje"/>
                        <field name="is_favorite" widget="project_favorite" nolabel="1"/>
                    </div>
                    
                    <!-- Línea 2: Fechas desde → hasta -->
                    <div t-if="record.date_start.raw_value or record.date.raw_value" 
                         class="text-muted d-flex align-items-center">
                        <i class="fa fa-clock-o me-1" role="img" aria-label="Fechas" title="Fechas"/>
                        <span class="me-2"><field name="date_start" widget="date"/></span>
                        <i class="fa fa-long-arrow-right mx-1" role="img" aria-label="a" title="a"/>
                        <span class="ms-2"><field name="date" widget="date"/></span>
                    </div>
                    
                    <!-- Bloque compacto personalizado -->
                    <div class="mt-2 pt-2" style="border-top: 1px solid #f0f0f0; font-size: 0.85rem;">
                        <!-- Gerente -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">
                                <i class="fa fa-user me-1" role="img" aria-label="Gerente" title="Gerente"/>Gerente:
                            </span>
                            <strong class="text-truncate ms-2" style="max-width: 60%;">
                                <field name="user_id" nolabel="1" options="{'no_open': True}"/>
                            </strong>
                        </div>
                        <!-- Visibilidad -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">
                                <i class="fa fa-eye me-1" role="img" aria-label="Visibilidad" title="Visibilidad"/>Visibilidad:
                            </span>
                            <span class="badge rounded-pill text-bg-danger border-0" 
                                  t-if="record.invisible.raw_value">
                                INVISIBLE
                            </span>
                            <span class="badge rounded-pill text-bg-success border-0" 
                                  t-if="!record.invisible.raw_value">
                                VISIBLE
                            </span>
                        </div>
                        <!-- Tareas (IZQUIERDA) + Días (DERECHA) -->
                        <div class="d-flex justify-content-between align-items-center">
							<span class="text-muted">
								<i class="fa fa-tasks me-1" role="img" aria-label="Tareas" title="Tareas"/>
								<field name="task_count" nolabel="1"/> tarea(s)
							</span>
							<span class="text-muted">
								<i class="fa fa-calendar-o me-1" role="img" aria-label="Días" title="Días"/>
								<field name="trip_days" nolabel="1"/> día(s)
							</span>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>	
</odoo>