<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo "Gestor de Viajes Restringido" -->
        <record id="group_gestor_viajes" model="res.groups">
            <field name="name">Gestor de Viajes (Restringido)</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="comment">Solo puede ver y editar los viajes de los que es responsable. No puede borrar etapas ni viajes.</field>
        </record>

        <!-- Regla: Solo ver proyectos donde es responsable -->
        <record id="rule_project_gestor_read" model="ir.rule">
            <field name="name">Gestor Viajes: solo ver sus proyectos</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gestor_viajes'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Puede editar tareas de sus proyectos pero NO borrarlas -->
        <record id="rule_task_gestor" model="ir.rule">
            <field name="name">Gestor Viajes: editar tareas de sus proyectos</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gestor_viajes'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Puede editar etapas de sus proyectos pero NO borrarlas -->
        <record id="rule_stage_gestor" model="ir.rule">
            <field name="name">Gestor Viajes: editar etapas de sus proyectos</field>
            <field name="model_id" ref="project.model_project_task_type"/>
            <field name="domain_force">[('project_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gestor_viajes'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>