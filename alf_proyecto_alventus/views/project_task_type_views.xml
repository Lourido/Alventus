<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario completa para project.task.type -->
    <record id="view_project_task_type_form_alf" model="ir.ui.view">
        <field name="name">project.task.type.form.alf</field>
        <field name="model">project.task.type</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Etapa de Tarea">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip"
                                invisible="not attachment_count">
                            <field name="attachment_count" widget="statinfo" string="Archivos"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                        <group>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="mail_template_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Archivos de la etapa" name="stage_attachments">
                            <!-- Botón FUERA del field readonly -->
                            <div class="mb-3">
                                <button name="action_add_attachment" type="object"
                                        string="📤 Añadir archivo" 
                                        class="btn-primary" 
                                        icon="fa-upload"/>
                                <span class="ms-3 text-muted">
                                    <i class="fa fa-info-circle me-1" role="img" aria-label="Info" title="Información"/>
                                    Los archivos se copiarán automáticamente al duplicar el viaje.
                                </span>
                            </div>
                            
                            <!-- Lista de archivos (solo lectura) -->
                            <field name="attachment_ids" readonly="1">
                                <list create="false" edit="false" delete="true">
                                    <field name="name" string="Nombre"/>
                                    <field name="mimetype" string="Tipo"/>
                                    <field name="create_date" string="Fecha de subida"/>
                                    <field name="datas" filename="name" string="Descargar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para project.task.type -->
    <record id="view_project_task_type_list_alf" model="ir.ui.view">
        <field name="name">project.task.type.list.alf</field>
        <field name="model">project.task.type</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="attachment_count" string="Archivos"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario simplificada para subir un adjunto a una etapa -->
    <record id="view_attachment_stage_form" model="ir.ui.view">
        <field name="name">ir.attachment.stage.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Subir archivo a la etapa">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Nombre del archivo"/>
                            <field name="datas" filename="name" string="Archivo"/>
                        </group>
                        <group>
                            <field name="description" string="Descripción / Notas"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Guardar" class="btn-primary" special="save"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>